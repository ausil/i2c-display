[Unit]
Description=I2C OLED Display Service
Documentation=https://github.com/ausil/i2c-display
# A panel that cannot be opened is a permanent failure until someone fixes the
# wiring or config, so stop hammering the bus and the journal instead of
# restarting forever (RestartSec=5s alone never hits the default rate limit).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
ExecStart=/usr/bin/i2c-displayd -config /etc/i2c-display/config.json
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelLogs=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

# Resource limits
MemoryMax=128M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
